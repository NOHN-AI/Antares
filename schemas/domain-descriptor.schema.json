{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nohn3043-arch/Antares/schemas/domain-descriptor.schema.json",
  "title": "Antares 2.1 federation.descriptor envelope",
  "description": "Signed envelope for a domain descriptor. CBOR on the wire; bytes shown base64 here for documentation.",
  "type": "object",
  "required": ["v", "m", "c", "k", "a", "b", "s"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": "2.1"},
    "m": {"const": "federation.descriptor"},
    "c": {"type": "string", "contentEncoding": "base64",
          "description": "UTF-8 bytes of the domain id. Signed."},
    "k": {"type": "string", "description": "Descriptor signing key id. Signed."},
    "a": {"type": "string", "enum": ["ed25519", "ed25519+ml-dsa-65"]},
    "b": {
      "type": "object",
      "required": ["dom", "dv", "vf", "vu", "gw", "sv", "ta", "rev"],
      "additionalProperties": false,
      "properties": {
        "dom": {"type": "string", "pattern": "^urn:antares:domain:"},
        "dv": {"type": "integer", "minimum": 0, "description": "Strictly increasing per domain."},
        "vf": {"type": "number", "description": "valid_from, epoch seconds."},
        "vu": {"type": "number", "description": "valid_until, epoch seconds."},
        "gw": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["uri", "tr", "pr", "pf", "pop"],
            "additionalProperties": false,
            "properties": {
              "uri": {"type": "string"},
              "tr": {"type": "string", "examples": ["http3", "a2a", "tcp+tls", "websocket"]},
              "pr": {"type": "integer", "minimum": 0, "maximum": 255,
                     "description": "Priority; the smallest value wins."},
              "pf": {"type": "array", "items": {"type": "string"}},
              "pop": {
                "description": "federation.gateway.pop envelope, or null when unproven.",
                "oneOf": [{"type": "object"}, {"type": "null"}]
              }
            }
          }
        },
        "sv": {"type": "array", "items": {"type": "string"}},
        "ta": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kid", "alg", "pk", "vf", "vu", "nx"],
            "additionalProperties": false,
            "properties": {
              "kid": {"type": "string"},
              "alg": {"type": "string", "enum": ["ed25519", "ed25519+ml-dsa-65"]},
              "pk": {
                "type": "object",
                "additionalProperties": {"type": "string"},
                "description": "{component: hex public key}."
              },
              "vf": {"type": "number"},
              "vu": {"type": "number", "description": "0 means no expiry."},
              "nx": {
                "type": "string",
                "description": "sha256: fingerprint of the successor key (rotation pre-commitment), or empty."
              }
            }
          }
        },
        "rev": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kid", "at", "rs"],
            "additionalProperties": false,
            "properties": {
              "kid": {"type": "string"},
              "at": {"type": "number", "description": "Revocation time, epoch seconds."},
              "rs": {"type": "string", "description": "Reason."}
            }
          }
        }
      }
    },
    "s": {"type": "string", "pattern": "^[0-9a-f]+$"}
  }
}
