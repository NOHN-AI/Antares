{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nohn3043-arch/Antares/schemas/domain-descriptor.schema.json",
  "title": "Antares DomainDescriptor",
  "type": "object",
  "required": [
    "domain_id",
    "descriptor_version",
    "valid_from",
    "valid_until",
    "gateways",
    "trust_anchors",
    "signature_algorithm",
    "signature"
  ],
  "properties": {
    "domain_id": {
      "type": "string",
      "pattern": "^urn:antares:domain:"
    },
    "descriptor_version": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing per domain."
    },
    "valid_from": {
      "type": "number",
      "description": "Unix epoch seconds."
    },
    "valid_until": {
      "type": "number",
      "description": "Unix epoch seconds. Must be greater than valid_from."
    },
    "gateways": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "transport", "priority"],
        "properties": {
          "uri": {"type": "string"},
          "transport": {
            "type": "string",
            "examples": ["http3", "a2a", "tcp+tls", "websocket"]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "profiles": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "items": {"type": "string"}
    },
    "trust_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "algorithm", "public_key"],
        "properties": {
          "key_id": {"type": "string"},
          "algorithm": {
            "type": "string",
            "enum": ["ed25519"]
          },
          "public_key": {
            "type": "string",
            "description": "Base64url-encoded raw 32-byte Ed25519 public key."
          }
        },
        "additionalProperties": false
      }
    },
    "revocation_endpoints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "signature_algorithm": {
      "type": "string",
      "enum": ["ed25519"]
    },
    "signature": {
      "type": "string",
      "description": "Hex-encoded Ed25519 signature over canonical CBOR bytes."
    }
  },
  "additionalProperties": false
}
